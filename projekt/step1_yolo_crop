import os
import cv2
import pandas as pd
import numpy as np
from ultralytics import YOLO

MODEL_PATH = 'runs/detect/train4/weights/best.pt'
TEST_IMAGES_DIR = 'dataset/images/val'
TRUTH_FILE = 'val_truth.csv'

OUT_DIR = 'out_crops'
OUT_CSV = 'out_crops/index.csv'

os.makedirs(OUT_DIR, exist_ok=True)

detector = YOLO(MODEL_PATH)


def pick_topk_boxes(res, k=3):
    if res.boxes is None or len(res.boxes) == 0:
        return []
    boxes = res.boxes.xyxy.cpu().numpy()
    confs = res.boxes.conf.cpu().numpy()
    idx = np.argsort(-confs)[:min(k, len(confs))]
    out = []
    for i in idx:
        x1, y1, x2, y2 = map(int, boxes[i][:4])
        out.append((x1, y1, x2, y2, float(confs[i])))
    return out


def generate_two_crops(img, x1, y1, x2, y2):
    h_tab, w_tab = y2 - y1, x2 - x1

    crop_a = img[
        y1 + int(h_tab * 0.10): y2 - int(h_tab * 0.10),
        x1 + int(w_tab * 0.08): x2 - int(w_tab * 0.04)
    ]
    crop_b = img[
        y1 + int(h_tab * 0.10): y2 - int(h_tab * 0.10),
        x1 + int(w_tab * 0.05): x2 - int(w_tab * 0.02)
    ]

    crops = []
    if crop_a is not None and crop_a.size > 0:
        crops.append(("A", crop_a))
    if crop_b is not None and crop_b.size > 0:
        crops.append(("B", crop_b))
    return crops


def clamp_box(x1, y1, x2, y2, W, H):
    x1 = max(0, min(x1, W - 1))
    x2 = max(0, min(x2, W - 1))
    y1 = max(0, min(y1, H - 1))
    y2 = max(0, min(y2, H - 1))
    if x2 <= x1: x2 = min(W - 1, x1 + 1)
    if y2 <= y1: y2 = min(H - 1, y1 + 1)
    return x1, y1, x2, y2


def main(limit=100):
    truth_df = pd.read_csv(TRUTH_FILE)
    rows = []

    processed = 0
    for _, row in truth_df.iterrows():
        if processed >= limit:
            break

        filename = str(row["filename"])
        img_path = os.path.join(TEST_IMAGES_DIR, filename)
        if not os.path.exists(img_path):
            continue

        img = cv2.imread(img_path)
        if img is None:
            continue

        H, W = img.shape[:2]
        results = detector(img, imgsz=960, device=0, verbose=False)

        saved_any = False

        for r in results:
            boxes = pick_topk_boxes(r, k=3)
            for bi, (x1, y1, x2, y2, conf) in enumerate(boxes):
                x1, y1, x2, y2 = clamp_box(x1, y1, x2, y2, W, H)

                for crop_tag, crop in generate_two_crops(img, x1, y1, x2, y2):
                    out_name = f"{os.path.splitext(filename)[0]}__b{bi}_{crop_tag}.png"
                    out_path = os.path.join(OUT_DIR, out_name)

                    cv2.imwrite(out_path, crop)

                    rows.append({
                        "filename": filename,
                        "crop_file": out_name,
                        "box_rank": bi,
                        "crop_tag": crop_tag,
                        "box_conf": conf,
                        "x1": x1, "y1": y1, "x2": x2, "y2": y2,
                        "plate_truth": str(row["plate"])
                    })
                    saved_any = True

        if not saved_any:
            rows.append({
                "filename": filename,
                "crop_file": "",
                "box_rank": -1,
                "crop_tag": "",
                "box_conf": 0.0,
                "x1": -1, "y1": -1, "x2": -1, "y2": -1,
                "plate_truth": str(row["plate"])
            })

        processed += 1

    os.makedirs(os.path.dirname(OUT_CSV), exist_ok=True)
    pd.DataFrame(rows).to_csv(OUT_CSV, index=False, encoding="utf-8")
    print(f"✅ Zapisano: {OUT_CSV}")
    print(f"✅ Cropy w:  {OUT_DIR}")


if __name__ == "__main__":
    main(limit=100)
